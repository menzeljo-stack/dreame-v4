{
    "elements": [
        {
            "type": "Label",
            "label": "Dreame Vacuum – direkte Anbindung an die Dreame Cloud."
        },
        {
            "type": "ValidationTextBox",
            "name": "Region",
            "caption": "Region (z.B. eu)"
        },
        {
            "type": "Select",
            "name": "AccountType",
            "caption": "Account Type",
            "options": [
                {
                    "caption": "dreame",
                    "value": "dreame"
                },
                {
                    "caption": "mova",
                    "value": "mova"
                },
                {
                    "caption": "trouver",
                    "value": "trouver"
                }
            ]
        },
        {
            "type": "ValidationTextBox",
            "name": "DID",
            "caption": "Device ID (did)"
        },
        {
            "type": "ValidationTextBox",
            "name": "Host",
            "caption": "Host/BindDomain (optional, z.B. 10000.mt.eu.iot.dreame.tech:19973)"
        },
        {
            "type": "Label",
            "label": "Login: auth_key (aus HA) ODER RefreshToken ODER Username/Password"
        },
        {
            "type": "ValidationTextBox",
            "name": "AuthKey",
            "caption": "auth_key (JWT aus HA) – empfohlen"
        },
        {
            "type": "ValidationTextBox",
            "name": "RefreshToken",
            "caption": "Refresh Token (optional; nur wenn du wirklich einen hast)"
        },
        {
            "type": "ValidationTextBox",
            "name": "Username",
            "caption": "Username (Fallback)"
        },
        {
            "type": "PasswordTextBox",
            "name": "Password",
            "caption": "Password (Fallback)"
        },
        {
            "type": "CheckBox",
            "name": "AutoCreateVariables",
            "caption": "Variablen automatisch anlegen"
        },
        {
            "type": "ValidationTextBox",
            "name": "StatusMapJson",
            "caption": "Status-Mapping (JSON optional, z.B. {\"14\":\"Mopp-Reinigung\"})"
        },
        {
            "type": "Label",
            "caption": "Station / Tanks: Diese Werte musst du einmal per Scan ermitteln (siid-piid)."
        },
        {
            "type": "ValidationTextBox",
            "name": "CleanWaterKey",
            "caption": "Frischwasser leer Key (siid-piid, z.B. 16-3)"
        },
        {
            "type": "ValidationTextBox",
            "name": "CleanWaterAlertValues",
            "caption": "Frischwasser Alert Werte (CSV, z.B. 1 oder 2,3)"
        },
        {
            "type": "ValidationTextBox",
            "name": "DirtyWaterKey",
            "caption": "Schmutzwasser voll Key (siid-piid)"
        },
        {
            "type": "ValidationTextBox",
            "name": "DirtyWaterAlertValues",
            "caption": "Schmutzwasser Alert Werte (CSV)"
        },
        {
            "type": "NumberSpinner",
            "name": "StatusPollInterval",
            "caption": "Status Polling (Sek.)",
            "minimum": 10,
            "maximum": 3600
        },
        {
            "type": "NumberSpinner",
            "name": "DeviceInfoPollInterval",
            "caption": "DeviceInfo Polling (Sek.)",
            "minimum": 60,
            "maximum": 86400
        },
        {
            "type": "CheckBox",
            "name": "AutoUpdateDeviceInfo",
            "caption": "DeviceInfo automatisch aktualisieren"
        },
        {
            "type": "Label",
            "label": "Visualisierung: \n• Command-Variable: Start/Pause/Stop/Zur Station/Spot/Beep.\n• Shortcuts: (A) Auswahl + separater Start-Button, und (B) pro Shortcut ein eigener Schalter.\nHinweis: Shortcuts werden bei „Shortcuts laden“ automatisch als Variablen angelegt."
        },
        {
            "type": "Label",
            "caption": "Tipp: Wasser-Tank leer herausfinden: Starte den Scan, wenn die App 'Wasser leer' meldet. Vergleiche ScanResultText/JSON mit einem Scan nach dem Auffüllen. Die Zeile(n) die sich ändern (siid-piid) bauen wir danach als eigene Variable ein."
        },
        {
            "type": "Label",
            "caption": "Weitere wichtige Werte (wie in Home Assistant): bitte per Scan die Keys (siid-piid) eintragen. Keine Status-Berechnung."
        },
        {
            "type": "ValidationTextBox",
            "name": "MopPadKey",
            "caption": "Mop Pad Key (siid-piid)"
        },
        {
            "type": "ValidationTextBox",
            "name": "RelocationStatusKey",
            "caption": "Relocation Status Key (siid-piid)"
        },
        {
            "type": "ValidationTextBox",
            "name": "SelfWashBaseStatusKey",
            "caption": "Self-Wash Base Status Key (siid-piid)"
        },
        {
            "type": "ValidationTextBox",
            "name": "StateKey",
            "caption": "State Key (siid-piid)"
        },
        {
            "type": "ValidationTextBox",
            "name": "StatusKey",
            "caption": "Status Key (siid-piid)"
        },
        {
            "type": "ValidationTextBox",
            "name": "StreamStatusKey",
            "caption": "Stream Status Key (siid-piid)"
        },
        {
            "type": "ValidationTextBox",
            "name": "TaskStatusKey",
            "caption": "Task Status Key (siid-piid)"
        },
        {
            "type": "ValidationTextBox",
            "name": "TaskTypeKey",
            "caption": "Task Type Key (siid-piid)"
        },
        {
            "type": "ValidationTextBox",
            "name": "RelocationStatusMapJson",
            "caption": "RelocationStatus Mapping (JSON optional)"
        },
        {
            "type": "ValidationTextBox",
            "name": "SelfWashBaseStatusMapJson",
            "caption": "SelfWashBaseStatus Mapping (JSON optional)"
        },
        {
            "type": "ValidationTextBox",
            "name": "StreamStatusMapJson",
            "caption": "StreamStatus Mapping (JSON optional)"
        },
        {
            "type": "ValidationTextBox",
            "name": "TaskStatusMapJson",
            "caption": "TaskStatus Mapping (JSON optional)"
        },
        {
            "type": "CheckBox",
            "name": "EnableDerivedTaskTracking",
            "caption": "Abgeleiteten Task-Tracker aktivieren (nicht empfohlen)"
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Login testen",
            "onClick": "DRMV_TestLogin($id);"
        },
        {
            "type": "Button",
            "caption": "Status aktualisieren",
            "onClick": "DRMV_UpdateStatus($id);"
        },
        {
            "type": "Button",
            "caption": "Geräteinfos aktualisieren",
            "onClick": "DRMV_UpdateDeviceInfo($id);"
        },
        {
            "type": "Button",
            "caption": "Shortcuts laden (Profile & Variablen anlegen)",
            "onClick": "DRMV_UpdateShortcuts($id);"
        },
        {
            "type": "Button",
            "caption": "Start",
            "onClick": "DRMV_StartCleaning($id);"
        },
        {
            "type": "Button",
            "caption": "Pause",
            "onClick": "DRMV_PauseCleaning($id);"
        },
        {
            "type": "Button",
            "caption": "Stop",
            "onClick": "DRMV_StopCleaning($id);"
        },
        {
            "type": "Button",
            "caption": "Zur Station",
            "onClick": "DRMV_Dock($id);"
        },
        {
            "type": "Button",
            "caption": "Spot Clean",
            "onClick": "DRMV_SpotClean($id);"
        },
        {
            "type": "Button",
            "caption": "Suchen / Beep",
            "onClick": "DRMV_Locate($id);"
        },
        {
            "type": "Button",
            "caption": "Station/Wasser Scan (siid 12-30, piid 1-60)",
            "onClick": "DRMV_ScanProperties($id, 12, 30, 1, 60);"
        }
    ]
}