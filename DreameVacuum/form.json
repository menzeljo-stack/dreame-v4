{
    "elements": [
        {
            "type": "Label",
            "label": "Dreame Vacuum – direkte Anbindung an die Dreame Cloud."
        },
        {
            "type": "ValidationTextBox",
            "name": "Region",
            "caption": "Region (z.B. eu)"
        },
        {
            "type": "Select",
            "name": "AccountType",
            "caption": "Account Type",
            "options": [
                { "caption": "dreame", "value": "dreame" },
                { "caption": "mova", "value": "mova" },
                { "caption": "trouver", "value": "trouver" }
            ]
        },
        {
            "type": "ValidationTextBox",
            "name": "DID",
            "caption": "Device ID (did)"
        },
        {
            "type": "ValidationTextBox",
            "name": "Host",
            "caption": "Host/BindDomain (optional, z.B. 10000.mt.eu.iot.dreame.tech:19973)"
        },
        {
            "type": "ValidationTextBox",
            "name": "RefreshToken",
            "caption": "RefreshToken (optional) – wenn 401 kommt: Feld leer lassen und einmal über Username/Password einloggen"
        },
        {
            "type": "ValidationTextBox",
            "name": "Username",
            "caption": "Username (E-Mail)"
        },
        {
            "type": "PasswordTextBox",
            "name": "Password",
            "caption": "Password"
        },
        {
            "type": "NumberSpinner",
            "name": "PollInterval",
            "caption": "Polling (Sek.)",
            "minimum": 10,
            "maximum": 3600
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Login testen",
            "onClick": "DRMV_TestLogin($id);"
        },
        {
            "type": "Button",
            "caption": "Geräteinfos aktualisieren",
            "onClick": "DRMV_UpdateDeviceInfo($id);"
        },
        {
            "type": "Button",
            "caption": "Status aktualisieren",
            "onClick": "DRMV_Update($id);"
        }
    ]
}
